{
  "name": "ncode-code-review",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome ci --error-on-warnings .",
    "format": "biome check --write .",
    "test": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info test/*.test.ts",
    "eval": "node evals/run.ts",
    "eval:compare": "node evals/compare.ts",
    "eval:confirm": "node evals/confirm.ts",
    "bench:review": "node tools/bench-review.ts",
    "bench:tests": "node tools/time-tests.ts",
    "train": "node training/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.326",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
